# Apeireth 1.0 release — docker-compose 环境变量占位 (台账 #47)
# 用法:
#   cp .env.example .env
#   # 编辑 .env 填真实强密码 (chmod 600 .env)
#   docker compose up -d
#
# ⚠️ 纪律:
#   - 禁止把真实密码 commit 到仓库 (.env 在 .gitignore)
#   - POSTGRES_PASSWORD 在 docker-compose.yml 用 ${VAR:?...} 强制必填, 缺省报错
#   - 推荐密码生成: openssl rand -base64 32 | tr -d '=+/' | head -c 32

# ============ 必填 (缺省 docker compose up 立即报错) ============

# PostgreSQL 强密码 (apeireth user, 1.0 release 生产部署必填)
# 例: POSTGRES_PASSWORD=9bF4xQ2pKm7sV8wR3nL6tY1jH5dZ
POSTGRES_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD__

# ============ 可选 (有默认值, 可不填) ============

# LLM 后端 (scripted | minimax | 自建), 默认 scripted (本地脚本桩, 跑通流程无外网依赖)
APEIRETH_LLM_BACKEND=scripted

# LLM API endpoint (生产 = https://api.minimaxi.com/v1)
APEIRETH_LLM_API_URL=https://api.minimaxi.com/v1

# LLM 模型 (默认 MiniMax-M3)
APEIRETH_LLM_MODEL=MiniMax-M3

# MiniMax coding plan key (留空 = 用 scripted 桩; 真用 LLM 必须填)
# 例: APEIRETH_API_KEY=eyJhbGciOi... (你自己的 key)
APEIRETH_API_KEY=