# Apeireth 环境变量示例（当前基线 v2.0.0-rc.1）
# 用法: cp .env.example .env 或直接在 shell 里 export / $env:
#
# ⚠️ 纪律:
#   - 禁止把真实 key commit 到仓库 (.env 在 .gitignore)
#   - 以下变量是代码实际读取的配置（经 grep 实测）；未列出的变量请勿依赖

# ============ Provider（模型提供方，真对话必填 key）============

# LLM API key（留空 = 走本地 scripted 桩，仅跑通流程）
# 例: APEIRETH_API_KEY=sk-...
APEIRETH_API_KEY=

# OpenAI 兼容端点（可选；桌面端向导/设置页亦可配置）
# 例: APEIRETH_API_URL=https://api.deepseek.com/v1
APEIRETH_API_URL=

# 端点可用模型列表（可选，逗号分隔）
APEIRETH_API_MODELS=

# 默认模型（可选；例: deepseek-v4-flash / MiniMax-M3）
APEIRETH_MODEL=

# 其他 provider 通道（可选，留空不启用）:
#   APEIRETH_ANTHROPIC_URL / APEIRETH_ANTHROPIC_KEY / APEIRETH_ANTHROPIC_MODELS
#   APEIRETH_OPENAI_URL / APEIRETH_OPENAI_MODELS
#   APEIRETH_EMBEDDING_URL / APEIRETH_EMBEDDING_KEY / APEIRETH_EMBEDDING_MODEL

# ============ 数据与身份（可选）============

# 数据目录（默认: 桌面端 %LOCALAPPDATA%\Apeireth；CLI 运行目录 .apeireth\）
APEIRETH_DATA_DIR=

# 会话/主体/人设标识（可选，多档案隔离用）
# APEIRETH_SESSION_DB=  APEIRETH_SUBJECT_ID=  APEIRETH_PERSONA_ID=  APEIRETH_CONTINUITY_ID=

# ============ 能力开关（可选，默认关闭 fail-closed）============

# 危险能力默认关闭，按需显式开启:
#   APEIRETH_ENABLE_SHELL=1        （shell 执行；配合 APEIRETH_SHELL_SANDBOX）
#   APEIRETH_ENABLE_FETCH=1        （网络抓取）
#   APEIRETH_ENABLE_ORGANS=1       （器官认知模块）
# 记忆类开关（详见 docs/02-guides/user-manual.md）:
#   APEIRETH_ENABLE_PROACTIVE_RECALL=1  APEIRETH_ENABLE_PREFERENCE_LEARNING=1 等

# ============ docker-compose 说明 ============
# docker-compose.yml 已更新为单服务（SQLite + 数据卷）编排，配合根目录 Dockerfile 使用:
#   docker compose up -d
# 旧版三服务（postgres/redis）编排见 git 历史；当前代码不读取
# POSTGRES_PASSWORD / APEIRETH_DB_URL / APEIRETH_REDIS_URL / APEIRETH_LLM_* 等旧变量。
