{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apeireth Companion",
  "version": "2.0.0-rc.1",
  "identifier": "app.apeireth.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Apeireth 伙伴",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Apeireth 桌面伙伴",
    "longDescription": "Apeireth 桌面伙伴 — 跨平台 AI 成长与协作桌面客户端",
    "copyright": "Copyright © 2026 Apeireth Team",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "wix": {
        "language": ["zh-CN", "en-US"],
        "upgradeCode": "B4A6C589-3543-4C4C-8D19-2D8C6FEA3F74"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
