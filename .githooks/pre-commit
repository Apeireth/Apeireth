#!/usr/bin/env bash
# pre-commit hook — Apeireth v2.0 (per ENGINEER-MANIFESTO §8.5 + §13 #12)
# 目的: 强制检查 author env var (per §13 #12 教训) + LOCKED 5 项 0 触碰警告 (per §10)
# 启用: git config core.hooksPath .githooks (per docs/04-internal/ENGINEER-MANIFESTO.md §8.5)

set -e

# 检查 1: author env var 设置 (per §13 #12 Round 4 真账)
# 根因: Round 2-4 我用 `git commit -F file` 时漏设 GIT_AUTHOR_NAME env var,
#       fallback 到 git config default = minimax-m3-agent (不是 Mavis)
# 修法: 必须设 4 env vars
if [ -z "$GIT_AUTHOR_NAME" ]; then
  echo "❌ PRE-COMMIT HOOK BLOCK (per §13 #12 教训)"
  echo ""
  echo "GIT_AUTHOR_NAME 未设置. commit author 会 fallback 到 git config default."
  echo ""
  echo "修法 (commit 前 export):"
  echo "  export GIT_AUTHOR_NAME=\"Mavis\""
  echo "  export GIT_AUTHOR_EMAIL=\"Mavis@apeireth.local\""
  echo "  export GIT_COMMITTER_NAME=\"Mavis\""
  echo "  export GIT_COMMITTER_EMAIL=\"Mavis@apeireth.local\""
  echo ""
  echo "或一次性:"
  echo "  export GIT_AUTHOR_NAME=Mavis GIT_AUTHOR_EMAIL=Mavis@apeireth.local \\"
  echo "         GIT_COMMITTER_NAME=Mavis GIT_COMMITTER_EMAIL=Mavis@apeireth.local"
  exit 1
fi

# 检查 2: LOCKED 5 项 0 触碰 (per §10 改前必查)
# 注: 这是警告, 不 abort. 主代理 override 用 --no-verify
LOCKED_FILES=(
  "crates/foundation/core/src/eight_anchors.rs"
  "crates/foundation/core/src/philosophy.rs"
  "crates/foundation/core/src/onion.rs"
  "Cargo.toml"
)
WARN=0
for f in "${LOCKED_FILES[@]}"; do
  if ! git diff --quiet HEAD -- "$f" 2>/dev/null; then
    echo "⚠️ WARNING: $f 有改动 (LOCKED 项, 需主代理拍板 per §10 真例外)"
    WARN=1
  fi
done
if [ $WARN -eq 1 ]; then
  echo ""
  echo "如主代理已拍板 (per §10 真例外), 用 --no-verify 跳过:"
  echo "  git commit --no-verify ..."
fi

# 检查 3: 文档治理门禁（2026-10-23 文档治理批）
# 目的: 断链 / 链接语法断裂 / 目录缺索引 / 豁免表腐化 —— 在**提交那一刻**就挡住，
#       而不是等 CI。CI 也会跑同一对脚本（.github/workflows/docs-governance.yml），
#       两处是同一判据，互为冗余。
# 判据:
#   docs_links.py  -> 断链=0、语法断裂=0、豁免表只减不增
#   docs_index.py  -> 每目录有 README、INDEX 全覆盖、层(L1-L5)与题材(1-12)合法、重定向表自洽
# 成本: 全树扫描约 2 秒。
if [ "${APEIRETH_SKIP_DOC_GATES:-0}" != "1" ]; then
  if command -v python3 >/dev/null 2>&1; then
    echo ""
    echo "── 文档治理门禁 ──"
    if ! python3 scripts/docs_links.py --check; then
      echo ""
      echo "❌ PRE-COMMIT HOOK BLOCK: 链接门禁未过"
      echo "   修法: 修好上面列出的断链 / 语法断裂 / 豁免表条目。"
      echo "   若确认是政策保留的历史引用, 登记到 docs/_known-missing.tsv（5 字段, 含复查日期）。"
      echo "   临时跳过: APEIRETH_SKIP_DOC_GATES=1 git commit ..."
      exit 1
    fi
    if ! python3 scripts/docs_index.py --check; then
      echo ""
      echo "❌ PRE-COMMIT HOOK BLOCK: 索引门禁未过"
      echo "   常见原因: 目录缺 README.md / INDEX.csv 未覆盖 / 层或题材非法 / 重定向表目标不存在。"
      echo "   索引生成: python3 scripts/docs_index.py --gen （保留人工标注的 topic/layer/disposition/target）"
      echo "   临时跳过: APEIRETH_SKIP_DOC_GATES=1 git commit ..."
      exit 1
    fi
    echo "✅ 文档治理门禁通过"
  else
    echo "⚠️ WARNING: 无 python3, 跳过文档治理门禁"
  fi
fi

exit 0
