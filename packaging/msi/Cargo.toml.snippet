# Apeireth MSI metadata snippet
# Paste into crates/adapters/cli/Cargo.toml under [package]
# Enables cargo-wix to generate Windows MSI package automatically.

[package.metadata.wix]
# WiX 3.x / 4.x Configuration
ui-dir = "packaging/msi"
wix-template = "packaging/msi/apeireth.wxs"
language = [1033]
# Default installation directory
install-path = "C:\\Program Files\\Apeireth"
# UpgradeCode family GUID
upgrade-guid = "9D7E2B45-7E3A-4F8A-B31F-79A5E2E39401"

