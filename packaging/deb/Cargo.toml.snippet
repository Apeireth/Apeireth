# Apeireth deb metadata snippet
# 粘贴到 crates/adapters/cli/Cargo.toml 的 [package] 之后
# 触发 cargo-deb 自动生成 .deb 包

[package.metadata.deb]
name = "apeireth"
maintainer = "Apeireth Team <dev@apeireth.io>"
copyright = "2026, Apeireth Team"
license-file = ["../../../LICENSE", "4"]
depends = ["ca-certificates", "libdbus-1-3"]
section = "utils"
priority = "optional"
extended-description = """\
Apeireth OS 2.0 — Cognitive Microkernel & AGI Operating System.
本包提供 Apeireth CLI / Gateway 二进制 (apeireth), 默认网关监听 :8080 (HTTP/WS)."""
description = "Apeireth OS 2.0 - AGI Operating System & Cognitive Microkernel"

# systemd 集成
[[package.metadata.deb.systemd-units]]
unit-scripts = "apeireth.service"

[package.metadata.deb.systemd-units."apeireth.service"]
enable = false
start = false

