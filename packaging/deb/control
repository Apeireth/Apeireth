# Apeireth Debian package control file (Apeireth 2.0 RC1, Linux packaging)
# 平台: Debian 11+ / Ubuntu 20.04+ (apt install ./apeireth_2.0.0~rc1_amd64.deb)
# 注: cargo-deb 默认从 Cargo.toml [package.metadata.deb] 生成 control 段, 本文件是
#     reference / fallback — 给 release engineer 在 release 时手动覆盖字段用.
#     正常构建走 packaging/deb/build-deb.sh + Cargo.toml metadata.
# 兄弟: packaging/deb/apeireth.service (systemd unit, 跟 deb 一起装到 /etc/systemd/system/)
# 卸载: sudo apt remove --purge apeireth  (用 packaging/deb/uninstall-deb.sh)

Package: apeireth
Version: 2.0.0~rc1
Section: utils
Priority: optional
Architecture: amd64 arm64
Maintainer: Apeireth Team <dev@apeireth.io>
Homepage: https://github.com/apeireth/apeireth-rust
Vcs-Browser: https://github.com/apeireth/apeireth-rust
Vcs-Git: https://github.com/apeireth/apeireth-rust.git

# 运行时依赖 (glibc >= 2.31 / Debian 11+ / Ubuntu 20.04+, rustls + bundled sqlite, ca-certificates, dbus)
Depends: ${misc:Depends}, ${shlibs:Depends}, ca-certificates, libdbus-1-3
Recommends: postgresql (>= 15), redis-server (>= 7.0)
Suggests: apeireth-doc (= ${binary:Version})
Conflicts: apeireth-beta, apeireth-nightly
Replaces: apeireth-cli
Description: Apeireth OS - AI Growth Platform & Cognitive Microkernel
 Apeireth OS is a production-grade autonomous AI growth platform and cognitive microkernel.
 This package provides the canonical Apeireth binary (apeireth) and systemd service.

# 体积 (估, build 后看实际)
Installed-Size: 51200

