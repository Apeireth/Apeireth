{
    "version": "2.0.0-rc.1",
    "description": "Apeireth OS 2.0 - AGI Operating System & AI Growth Platform (API server & CLI)",
    "homepage": "https://github.com/apeireth/apeireth-rust",
    "license": "Apache-2.0",
    "depends": "",
    "suggest": {
        "postgresql": "extras/postgresql",
        "redis": "main/redis"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/apeireth/apeireth-rust/releases/download/v2.0.0-rc.1/apeireth-2.0.0-rc.1-windows-x86_64.zip",
            "hash": "REPLACE_WITH_RELEASE_SHA256_AT_TAG_TIME"
        }
    },
    "bin": [
        "apeireth.exe",
        [
            "bin\\apeireth-serve.bat",
            "apeireth-serve"
        ]
    ],
    "env_set": {
        "APEIRETH_HOME": "%USERPROFILE%\\.apeireth",
        "APEIRETH_CONFIG": "%APEIRETH_HOME%\\config.toml"
    },
    "persist": "data",
    "post_install": [
        "[Environment]::SetEnvironmentVariable('Path', $env:Path + ';$dir', 'User')",
        "if (!(Test-Path $env:APEIRETH_HOME)) { New-Item -ItemType Directory -Path $env:APEIRETH_HOME -Force | Out-Null }",
        "Write-Host 'Apeireth installed successfully. Run: apeireth --version or apeireth serve'"
    ],
    "pre_uninstall": [
        "Write-Host 'Stopping Apeireth...'",
        "Get-Process apeireth -ErrorAction SilentlyContinue | Stop-Process -Force"
    ],
    "checkver": {
        "github": "https://github.com/apeireth/apeireth-rust"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/apeireth/apeireth-rust/releases/download/v$version/apeireth-$version-windows-x86_64.zip"
            }
        }
    }
}

