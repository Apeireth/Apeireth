# research/ 实验区 gitignore
# 构建产物 (runner 独立项目) 不入库。
runners/target/
# 大文件数据集不入库 (见 datasets/README.md MANIFEST 约定)。
datasets/**/raw/*.bin
datasets/**/raw/*.db
datasets/locomo/src/
datasets/locomo-mc10/*.json
datasets/locomo-mc10/LICENSE
datasets/locomo-mc10/README.md
datasets/longmemeval/src/
datasets/longmemeval/*.json
# 验证工具 jar (tla2tools, MIT; 按 README 指引自取) 不入库。
verification/tla/*.jar

# 生成的运行日志可复现 (同 seed 再生), 不入库; 保留本地作为证据.
logs/*.jsonl
verification/tla/states/
verification/kani/target/
