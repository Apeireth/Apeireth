# ASI systemd unit — V1075 (借鉴 systemd2010 [Service] ExecStart Restart)
[Unit]
Description=Apeireth ASI Real Service (V1075)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apeireth
WorkingDirectory=/opt/apeireth
Environment=ASI_VERSION=0.1.0
Environment=V1075_HOST=0.0.0.0
Environment=V1075_PORT=8766
ExecStart=/usr/bin/python3 -m apeireth.v1075_asi_real_deployment_run --serve --host 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=apeireth-asi

[Install]
WantedBy=multi-user.target
